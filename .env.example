# Copy this file to .env.local and fill in your own values.

# Required for the FastAPI backend URL the Next.js API routes proxy to.
# Default matches `uvicorn main:app --port 8000` — change only if you run
# the backend on a different port/host.
BACKEND_URL=http://localhost:8000

# Required to enable the live AI explanation panel (POST /api/explain).
# Get a free key at https://openrouter.ai/keys — the app uses the
# "openrouter/free" auto-router model, so no paid credits are required.
# Without this set, the dashboard still fully works (charts, detection,
# mission controls) — only the "Explain this flag" button will show a
# clear setup message instead of an AI explanation.
OPENROUTER_API_KEY=
